          "expr": "host_memory_total_bytes{job=\"psutil-system-monitor\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "host_memory_used_bytes{job=\"psutil-system-monitor\"}",
          "legendFormat": "used",
          "refId": "B"

{
  "description": "Project 6 \u2014 psutil-based system metrics from a container reading the host's /proc: CPU, memory, load, disk usage and I/O, container network throughput.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],

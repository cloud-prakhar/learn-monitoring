          "expr": "rate(host_disk_read_bytes_total{job=\"psutil-system-monitor\"}[1m])",
          "legendFormat": "read",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(host_disk_write_bytes_total{job=\"psutil-system-monitor\"}[1m])",
          "legendFormat": "write",
          "refId": "B"

          "mode": "multi",
          "sort": "none"
        }
      },
      "title": "Network Throughput \u2014 container interfaces (Sent vs Received)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(host_net_bytes_recv_total{job=\"psutil-system-monitor\"}[1m])",
          "legendFormat": "recv {{nic}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(host_net_bytes_sent_total{job=\"psutil-system-monitor\"}[1m])",
          "legendFormat": "sent {{nic}}",
          "refId": "B"
        }
      ],
      "description": "/proc/net is per network namespace, so this is the container's eth0/lo, not the host NICs."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {

      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "Value #A": "Up",
              "Value #B": "HTTP Status",
              "Value #C": "Duration",
              "instance": "Target",
              "module": "Module"
            }
          }
        }
      ],
      "title": "Current Status",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "probe_success{job=\"blackbox-http\"}",
          "legendFormat": "",
          "refId": "A",
